+
+// FakeR36S: lets the game record which memory each asset is built in (persistent save states).
+// Weak, so builds without the hook (2 Ship 2 Harkinian) link unchanged.
+extern "C" void FrTrack_Push(const char* path) __attribute__((weak));
+extern "C" void FrTrack_Pop(void) __attribute__((weak));
+namespace {
+struct FrTrackScope {
+    bool open;
+    explicit FrTrackScope(const std::string& path) : open(FrTrack_Push != nullptr) {
+        if (open) FrTrack_Push(path.c_str());
+    }
+    void Close() {
+        if (open && FrTrack_Pop != nullptr) FrTrack_Pop();
+        open = false;
+    }
+    ~FrTrackScope() {
+        Close();
+    }
+};
+} // namespace
 
