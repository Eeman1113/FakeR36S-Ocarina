+// A file is only consulted again by the files listing it in external_files (always a block list in the yml)
+void Companion::CountExternalRefs(const std::vector<fs::directory_entry>& entries) {
+    for (const auto& entry : entries) {
+        if (entry.is_directory()) {
+            continue;
+        }
+        std::ifstream in(entry.path());
+        std::string line;
+        bool list = false;
+        while (std::getline(in, line)) {
+            const auto first = line.find_first_not_of(' ');
+            if (first == std::string::npos) {
+                continue;
+            }
+            if (line.compare(first, 15, "external_files:") == 0) {
+                list = true;
+            } else if (list && line.compare(first, 2, "- ") == 0) {
+                auto name = line.substr(first + 2);
+                name.erase(name.find_last_not_of(" \r") + 1);
+                this->gExternalRefs[(this->gSourceDirectory / name).generic_string()]++;
+            } else {
+                list = false;
+            }
+        }
+    }
+}
+
+// Drops what this round processed, and the externals it used, once no file left lists them
+void Companion::ReleaseRound() {
+    std::vector<std::string> candidates;
+    for (auto& [file, externals] : this->gRoundFiles) {
+        candidates.push_back(file);
+        for (auto& ext : externals) {
+            this->gExternalRefs[ext]--;
+            candidates.push_back(ext);
+        }
+    }
+    this->gRoundFiles.clear();
+    for (auto& file : candidates) {
+        auto refs = this->gExternalRefs.find(file);
+        if ((refs == this->gExternalRefs.end() || refs->second <= 0) && this->gProcessedFiles.contains(file) &&
+            this->gAddrMap.contains(file)) {
+            this->ReleaseFile(file);
+        }
+    }
+}
+
+void Companion::ReleaseFile(const std::string& file) {
+    auto drop = [this](const std::string& f) {
+        this->gParseResults.erase(f);
+        this->gAddrMap.erase(f);
+        this->gNodesByTypeCache.erase(f);
+        this->gNodesByTypeCacheValid.erase(f);
+    };
+    if (auto subs = this->gSubFilesOf.find(file); subs != this->gSubFilesOf.end()) {
+        for (auto& sub : subs->second) {
+            drop(sub);
+        }
+        this->gSubFilesOf.erase(subs);
+    }
+    drop(file);
+}
