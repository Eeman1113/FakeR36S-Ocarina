+// Reads slot's file into a new SaveState, assets reloaded and their pointers rebuilt; nullptr if it can't
+static std::shared_ptr<SaveState> Read(unsigned slot) {
+    FILE* f = fopen(FileFor(slot).c_str(), "rb");
+    if (f == nullptr) return nullptr;
+    std::vector<uint8_t> file;
+    uint8_t chunk[65536];
+    size_t n;
+    while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) file.insert(file.end(), chunk, chunk + n);
+    fclose(f);
+    if (file.size() < 8 || memcmp(file.data(), "FRSZ", 4) != 0) return nullptr;
+    uint32_t rawSize;
+    memcpy(&rawSize, file.data() + 4, 4);
+    std::vector<uint8_t> raw;
+    if (!Decode(file.data() + 8, file.size() - 8, raw, rawSize)) return nullptr;
+
+    size_t pos = 0;
+    auto need = [&](size_t k) { return pos + k <= raw.size(); };
+    if (!need(sizeof(Header))) return nullptr;
+    Header h;
+    memcpy(&h, raw.data(), sizeof(h));
+    pos += sizeof(h);
+    if (memcmp(h.magic, "FRS1", 4) != 0 || h.version != kVersion) return nullptr;
+    if (memcmp(h.build, kBuild, sizeof(h.build)) != 0) {
+        SPDLOG_WARN("[FakeR36S] state {} is from another build of the game: not loading it", slot);
+        return nullptr;
+    }
+    if (!gFrFixedHeaps || h.sysHeap != (uint32_t)(uintptr_t)gSystemHeap ||
+        h.audioHeap != (uint32_t)(uintptr_t)gAudioHeap || h.infoSize != sizeof(SaveStateInfo) ||
+        h.nOverlays != kOvlCount) {
+        SPDLOG_WARN("[FakeR36S] state {} doesn't match this run's memory layout: not loading it", slot);
+        return nullptr;
+    }
+    std::vector<std::string> paths;
+    for (uint32_t i = 0; i < h.nPaths; i++) {
+        size_t e = pos;
+        while (e < raw.size() && raw[e] != 0) e++;
+        if (e >= raw.size()) return nullptr;
+        paths.emplace_back((const char*)raw.data() + pos, e - pos);
+        pos = e + 1;
+    }
+    pos = (pos + 3) & ~(size_t)3;
+    if (!need((size_t)h.nFixups * sizeof(Fixup))) return nullptr;
+    std::vector<Fixup> fix(h.nFixups);
+    memcpy(fix.data(), raw.data() + pos, fix.size() * sizeof(Fixup));
+    pos += fix.size() * sizeof(Fixup);
+
+    auto st = std::make_shared<SaveState>(OTRGlobals::Instance->gSaveStateMgr, slot);
+    SaveStateInfo* info = st->info.get();
+    uint8_t *a, *b;
+    size_t la, lb;
+    Regions(info, a, la, b, lb);
+    if (la != h.sizeA || lb != h.sizeB || !need(la)) return nullptr;
+    memcpy(a, raw.data() + pos, la);
+    pos = (pos + la + 3) & ~(size_t)3;
+    if (!need(lb)) return nullptr;
+    memcpy(b, raw.data() + pos, lb);
+    pos = (pos + lb + 3) & ~(size_t)3;
+    for (uint32_t i = 0; i < kOvlCount; i++) {
+        if (!need(4)) return nullptr;
+        uint32_t len;
+        memcpy(&len, raw.data() + pos, 4);
+        pos += 4;
+        if (len) {
+            if (!need(len)) return nullptr;
+            (info->*kOvl[i].member) = std::make_unique<uint8_t[]>(len);
+            memcpy((info->*kOvl[i].member).get(), raw.data() + pos, len);
+        }
+        pos = (pos + len + 3) & ~(size_t)3;
+    }
+
+    // load every asset the state points into (kept alive with the state), then rebuild the pointers
+    auto rm = Ship::Context::GetRawInstance()->GetResourceManager();
+    for (auto& p : paths) {
+        auto res = rm->LoadResource(p, true);
+        if (res == nullptr) {
+            SPDLOG_WARN("[FakeR36S] state {} needs asset {}, which didn't load", slot, p);
+            return nullptr;
+        }
+        st->frKeep.push_back(res);
+    }
+    for (auto& x : fix) {
+        uintptr_t base;
+        if (x.path >= paths.size() || !frtrack::Lookup(paths[x.path], x.idx, base)) {
+            SPDLOG_WARN("[FakeR36S] state {}: block {} of {} is missing", slot, x.idx,
+                        x.path < paths.size() ? paths[x.path] : std::string("?"));
+            return nullptr;
+        }
+        uint8_t* buf;
+        size_t blen;
+        if (x.region == 0) {
+            buf = a;
+            blen = la;
+        } else if (x.region == 1) {
+            buf = b;
+            blen = lb;
+        } else if (x.region - 2 < kOvlCount && (info->*kOvl[x.region - 2].member) != nullptr) {
+            buf = (info->*kOvl[x.region - 2].member).get();
+            blen = Measure(kOvl[x.region - 2].fn);
+        } else {
+            return nullptr;
+        }
+        if ((size_t)x.offset + 4 > blen) return nullptr;
+        uint32_t v = (uint32_t)(base + x.delta);
+        memcpy(buf + x.offset, &v, 4);
+    }
+    SPDLOG_INFO("[FakeR36S] state {} read from the card: {} pointers rebuilt in {} assets", slot, fix.size(),
+                paths.size());
+    return st;
+}
+
+// One background writer, so the game never waits on the SD card
+struct Job {
+    unsigned slot;
+    std::shared_ptr<SaveState> st;
+    std::vector<frtrack::Range> reg;
+};
+// Never destroyed: the writer thread sleeps on jCv, and destroying a condition variable that a
+// thread is still waiting on (as static destructors would when the game quits) can hang the exit.
+struct Queue {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<Job> jobs;
+    bool workerUp = false;
+};
+static Queue& Q() {
+    static Queue* q = new Queue();
+    return *q;
+}
+static std::atomic<int> pending{ 0 };
+
+static void Worker() {
+    for (;;) {
+        Job job;
+        {
+            std::unique_lock<std::mutex> lock(Q().mu);
+            Q().cv.wait(lock, [] { return !Q().jobs.empty(); });
+            job = std::move(Q().jobs.front());
+            Q().jobs.pop_front();
+        }
+        if (!Write(job.slot, job.st->info.get(), job.reg)) SPDLOG_ERROR("[FakeR36S] could not write state {}", job.slot);
+        job.st.reset();
+        pending.fetch_sub(1);
+    }
+}
+
+static void Enqueue(unsigned slot, std::shared_ptr<SaveState> st) {
+    if (!gFrFixedHeaps || st == nullptr) return;
+    Job job{ slot, std::move(st), frtrack::Snapshot() };   // the registry as it is now, with the state
+    Queue& q = Q();
+    std::lock_guard<std::mutex> lock(q.mu);
+    // a newer copy of the same slot replaces one still waiting
+    for (auto it = q.jobs.begin(); it != q.jobs.end(); ++it) {
+        if (it->slot == slot) {
+            *it = std::move(job);
+            q.cv.notify_one();
+            return;
+        }
+    }
+    q.jobs.push_back(std::move(job));
+    pending.fetch_add(1);
+    if (!q.workerUp) {
+        std::thread(Worker).detach();
+        q.workerUp = true;
+    }
+    q.cv.notify_one();
+}
+
+static void WaitIdle(uint32_t ms) {
+    const uint32_t until = SDL_GetTicks() + ms;
+    while (pending.load() > 0 && SDL_GetTicks() < until) SDL_Delay(20);
+}
