+// ================================================================================================
+// FakeR36S-Ocarina: save states on the card, valid after a restart (docs/persistent-savestates.md)
+//
+// A state is a copy of game memory full of pointers. With the heaps and soh.elf at fixed addresses
+// (patch 0006, -no-pie) only pointers into assets from the .o2r still move between runs. Every
+// asset is built inside ResourceManager::LoadResourceProcess, which libultraship patch 0003 wraps
+// in FrTrack_Push/FrTrack_Pop; the global operator new below records each block allocated in
+// between as (asset path, block number). Loading the same asset again allocates the same blocks in
+// the same order, so a pointer saved as (asset, block, offset) can be rebuilt in any later run.
+// ================================================================================================
+extern "C" int gFrFixedHeaps;
+
+namespace frtrack {
+template <class T> struct MallocAlloc {
+    using value_type = T;
+    MallocAlloc() = default;
+    template <class U> MallocAlloc(const MallocAlloc<U>&) {
+    }
+    T* allocate(size_t n) {
+        void* p = malloc(n * sizeof(T));
+        if (p == nullptr) throw std::bad_alloc();
+        return static_cast<T*>(p);
+    }
+    void deallocate(T* p, size_t) {
+        free(p);
+    }
+    template <class U> bool operator==(const MallocAlloc<U>&) const {
+        return true;
+    }
+    template <class U> bool operator!=(const MallocAlloc<U>&) const {
+        return false;
+    }
+};
+
+struct Block {
+    uint32_t path, idx, size;
+};
+struct StrLess {
+    bool operator()(const char* a, const char* b) const {
+        return strcmp(a, b) < 0;
+    }
+};
+using BlockMap = std::map<uintptr_t, Block, std::less<uintptr_t>, MallocAlloc<std::pair<const uintptr_t, Block>>>;
+using KeyMap = std::map<uint64_t, uintptr_t, std::less<uint64_t>, MallocAlloc<std::pair<const uint64_t, uintptr_t>>>;
+using PathIndex = std::map<const char*, uint32_t, StrLess, MallocAlloc<std::pair<const char* const, uint32_t>>>;
+using PathVec = std::vector<char*, MallocAlloc<char*>>;
+
+// never destroyed: the tracker must outlive every static destructor that frees memory
+static std::mutex& Mu() {
+    static std::mutex* m = new (malloc(sizeof(std::mutex))) std::mutex();
+    return *m;
+}
+static BlockMap& Blocks() {
+    static BlockMap* m = new (malloc(sizeof(BlockMap))) BlockMap();
+    return *m;
+}
+static KeyMap& Keys() {
+    static KeyMap* m = new (malloc(sizeof(KeyMap))) KeyMap();
+    return *m;
+}
+static PathIndex& Index() {
+    static PathIndex* m = new (malloc(sizeof(PathIndex))) PathIndex();
+    return *m;
+}
+static PathVec& Paths() {
+    static PathVec* m = new (malloc(sizeof(PathVec))) PathVec();
+    return *m;
+}
+
+struct Frame {
+    uint32_t path, next;
+};
+static const int kMaxDepth = 32;
+static thread_local Frame tStack[kMaxDepth];
+static thread_local int tDepth = 0;
+static std::atomic<uint32_t> gCount{ 0 };
+static std::atomic<uintptr_t> gLo{ UINTPTR_MAX }, gHi{ 0 };
+
+static uint64_t Key(uint32_t path, uint32_t idx) {
+    return ((uint64_t)path << 32) | idx;
+}
+
+// with Mu() held
+static uint32_t Intern(const char* path) {
+    auto it = Index().find(path);
+    if (it != Index().end()) return it->second;
+    char* copy = strdup(path);
+    uint32_t id = (uint32_t)Paths().size();
+    Paths().push_back(copy);
+    Index()[copy] = id;
+    return id;
+}
+
+static void OnAlloc(void* p, size_t n) {
+    if (p == nullptr || tDepth == 0 || tDepth > kMaxDepth) return;
+    Frame& f = tStack[tDepth - 1];
+    const uintptr_t a = (uintptr_t)p;
+    {
+        std::lock_guard<std::mutex> lock(Mu());
+        Blocks()[a] = { f.path, f.next, (uint32_t)n };
+        Keys()[Key(f.path, f.next)] = a;
+    }
+    f.next++;
+    gCount.fetch_add(1, std::memory_order_relaxed);
+    uintptr_t lo = gLo.load(std::memory_order_relaxed);
+    while (a < lo && !gLo.compare_exchange_weak(lo, a)) {
+    }
+    uintptr_t hi = gHi.load(std::memory_order_relaxed);
+    while (a + n > hi && !gHi.compare_exchange_weak(hi, a + n)) {
+    }
+}
+
+static void OnFree(void* p) {
+    if (p == nullptr || gCount.load(std::memory_order_relaxed) == 0) return;
+    const uintptr_t a = (uintptr_t)p;
+    if (a < gLo.load(std::memory_order_relaxed) || a >= gHi.load(std::memory_order_relaxed)) return;
+    std::lock_guard<std::mutex> lock(Mu());
+    auto it = Blocks().find(a);
+    if (it == Blocks().end()) return;
+    auto kt = Keys().find(Key(it->second.path, it->second.idx));
+    if (kt != Keys().end() && kt->second == a) Keys().erase(kt);
+    Blocks().erase(it);
+    gCount.fetch_sub(1, std::memory_order_relaxed);
+}
+
+// A copy of the registry, sorted by address, for scanning a state without holding the lock
+struct Range {
+    uintptr_t base, end;
+    uint32_t path, idx;
+};
+static std::vector<Range> Snapshot() {
+    std::vector<Range> out;
+    std::lock_guard<std::mutex> lock(Mu());
+    out.reserve(Blocks().size());
+    for (auto& b : Blocks()) out.push_back({ b.first, b.first + b.second.size, b.second.path, b.second.idx });
+    return out;
+}
+static std::string PathOf(uint32_t id) {
+    std::lock_guard<std::mutex> lock(Mu());
+    return id < Paths().size() ? std::string(Paths()[id]) : std::string();
+}
+static bool Lookup(const std::string& path, uint32_t idx, uintptr_t& base) {
+    std::lock_guard<std::mutex> lock(Mu());
+    auto it = Index().find(path.c_str());
+    if (it == Index().end()) return false;
+    auto kt = Keys().find(Key(it->second, idx));
+    if (kt == Keys().end()) return false;
+    base = kt->second;
+    return true;
+}
+} // namespace frtrack
+
+extern "C" void FrTrack_Push(const char* path) {
+    using namespace frtrack;
+    if (tDepth < kMaxDepth) {
+        uint32_t id;
+        {
+            std::lock_guard<std::mutex> lock(Mu());
+            id = Intern(path);
+        }
+        tStack[tDepth] = { id, 0 };
+    }
+    tDepth++;
+}
+
+extern "C" void FrTrack_Pop(void) {
+    if (frtrack::tDepth > 0) frtrack::tDepth--;
+}
+
+// The program-wide allocator: plain malloc, plus the record above while an asset is being built.
+void* operator new(std::size_t n) {
+    void* p = std::malloc(n ? n : 1);
+    if (p == nullptr) throw std::bad_alloc();
+    frtrack::OnAlloc(p, n);
+    return p;
+}
+void* operator new[](std::size_t n) {
+    return ::operator new(n);
+}
+void* operator new(std::size_t n, const std::nothrow_t&) noexcept {
+    void* p = std::malloc(n ? n : 1);
+    frtrack::OnAlloc(p, n);
+    return p;
+}
+void* operator new[](std::size_t n, const std::nothrow_t& t) noexcept {
+    return ::operator new(n, t);
+}
+void* operator new(std::size_t n, std::align_val_t al) {
+    std::size_t a = (std::size_t)al < sizeof(void*) ? sizeof(void*) : (std::size_t)al;
+    void* p = nullptr;
+    if (posix_memalign(&p, a, n ? n : 1) != 0) throw std::bad_alloc();
+    frtrack::OnAlloc(p, n);
+    return p;
+}
+void* operator new[](std::size_t n, std::align_val_t al) {
+    return ::operator new(n, al);
+}
+void* operator new(std::size_t n, std::align_val_t al, const std::nothrow_t&) noexcept {
+    try {
+        return ::operator new(n, al);
+    } catch (...) { return nullptr; }
+}
+void* operator new[](std::size_t n, std::align_val_t al, const std::nothrow_t& t) noexcept {
+    return ::operator new(n, al, t);
+}
+void operator delete(void* p) noexcept {
+    frtrack::OnFree(p);
+    std::free(p);
+}
+void operator delete[](void* p) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void* p, std::size_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void* p, std::size_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void* p, const std::nothrow_t&) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void* p, const std::nothrow_t&) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void* p, std::align_val_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void* p, std::align_val_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void* p, std::size_t, std::align_val_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void* p, std::size_t, std::align_val_t) noexcept {
+    ::operator delete(p);
+}
+void operator delete(void* p, std::align_val_t, const std::nothrow_t&) noexcept {
+    ::operator delete(p);
+}
+void operator delete[](void* p, std::align_val_t, const std::nothrow_t&) noexcept {
+    ::operator delete(p);
+}
