+static size_t Measure(void (*fn)(SaveStateCtx*)) {
+    SaveStateCtx ctx = {};
+    ctx.mode = SHIP_SAVESTATE_MEASURE;
+    fn(&ctx);
+    return ctx.offset;
+}
