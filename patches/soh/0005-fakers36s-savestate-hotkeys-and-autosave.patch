+// The plain-data parts of SaveStateInfo: everything before the first unique_ptr and after the last
+static void Regions(SaveStateInfo* info, uint8_t*& a, size_t& la, uint8_t*& b, size_t& lb) {
+    uint8_t* base = reinterpret_cast<uint8_t*>(info);
+    a = base;
+    la = reinterpret_cast<uint8_t*>(&info->matrixState) - base;
+    b = reinterpret_cast<uint8_t*>(&info->transitionActorCount_copy);
+    lb = sizeof(SaveStateInfo) - (size_t)(b - base);
+}
+
+static std::string Dir() {
+    return Ship::Context::GetPathRelativeToAppDirectory("states");
+}
+static std::string FileFor(unsigned slot) {
+    return Dir() + "/slot" + std::to_string(slot) + ".frstate";
+}
+
+// Zero runs dominate the heaps: [nonzero word count][words][zero word count]...
+static void Encode(const std::vector<uint8_t>& in, std::vector<uint8_t>& out) {
+    const size_t words = in.size() / 4;
+    const uint32_t* w = reinterpret_cast<const uint32_t*>(in.data());
+    out.clear();
+    auto put = [&](uint32_t v) { out.insert(out.end(), (uint8_t*)&v, (uint8_t*)&v + 4); };
+    size_t i = 0;
+    while (i < words) {
+        size_t s = i;
+        while (i < words && w[i] != 0) i++;
+        put((uint32_t)(i - s));
+        out.insert(out.end(), (const uint8_t*)(w + s), (const uint8_t*)(w + i));
+        s = i;
+        while (i < words && w[i] == 0) i++;
+        put((uint32_t)(i - s));
+    }
+}
+static bool Decode(const uint8_t* in, size_t len, std::vector<uint8_t>& out, size_t rawSize) {
+    out.assign(rawSize, 0);
+    size_t pos = 0, o = 0;
+    while (pos + 4 <= len) {
+        uint32_t nz;
+        memcpy(&nz, in + pos, 4);
+        pos += 4;
+        if (pos + (size_t)nz * 4 > len || o + (size_t)nz * 4 > rawSize) return false;
+        memcpy(out.data() + o, in + pos, (size_t)nz * 4);
+        pos += (size_t)nz * 4;
+        o += (size_t)nz * 4;
+        if (pos + 4 > len) break;
+        uint32_t z;
+        memcpy(&z, in + pos, 4);
+        pos += 4;
+        o += (size_t)z * 4;
+        if (o > rawSize) return false;
+    }
+    return true;
+}
+
+static void Scan(const uint8_t* buf, size_t len, uint32_t region, const std::vector<frtrack::Range>& reg,
+                 std::vector<Fixup>& out) {
+    if (reg.empty()) return;
+    const uintptr_t lo = reg.front().base, hi = reg.back().end;
+    for (size_t o = 0; o + 4 <= len; o += 4) {
+        uint32_t v;
+        memcpy(&v, buf + o, 4);
+        if (v < lo || v >= hi) continue;
+        auto it = std::upper_bound(reg.begin(), reg.end(), (uintptr_t)v,
+                                   [](uintptr_t x, const frtrack::Range& r) { return x < r.base; });
+        if (it == reg.begin()) continue;
+        --it;
+        if (v >= it->end) continue;
+        out.push_back({ region, (uint32_t)o, it->path, it->idx, (uint32_t)(v - it->base) });
+    }
+}
+
+static bool Write(unsigned slot, SaveStateInfo* info, const std::vector<frtrack::Range>& reg) {
+    uint8_t *a, *b;
+    size_t la, lb;
+    Regions(info, a, la, b, lb);
+    std::vector<size_t> ovlSize(kOvlCount);
+    std::vector<Fixup> fix;
+    Scan(a, la, 0, reg, fix);
+    Scan(b, lb, 1, reg, fix);
+    for (uint32_t i = 0; i < kOvlCount; i++) {
+        ovlSize[i] = Measure(kOvl[i].fn);
+        if ((info->*kOvl[i].member) != nullptr) Scan((info->*kOvl[i].member).get(), ovlSize[i], 2 + i, reg, fix);
+    }
+    // the asset paths the fixups name, renumbered from 0
+    std::map<uint32_t, uint32_t> remap;
+    std::vector<std::string> paths;
+    for (auto& f : fix) {
+        auto it = remap.find(f.path);
+        if (it == remap.end()) {
+            it = remap.emplace(f.path, (uint32_t)paths.size()).first;
+            paths.push_back(frtrack::PathOf(f.path));
+        }
+        f.path = it->second;
+    }
+
+    std::vector<uint8_t> raw;
+    auto put = [&](const void* p, size_t n) { raw.insert(raw.end(), (const uint8_t*)p, (const uint8_t*)p + n); };
+    Header h = {};
+    memcpy(h.magic, "FRS1", 4);
+    h.version = kVersion;
+    memcpy(h.build, kBuild, sizeof(h.build));
+    h.sysHeap = (uint32_t)(uintptr_t)gSystemHeap;
+    h.audioHeap = (uint32_t)(uintptr_t)gAudioHeap;
+    h.infoSize = sizeof(SaveStateInfo);
+    h.sizeA = (uint32_t)la;
+    h.sizeB = (uint32_t)lb;
+    h.nOverlays = kOvlCount;
+    h.nPaths = (uint32_t)paths.size();
+    h.nFixups = (uint32_t)fix.size();
+    put(&h, sizeof(h));
+    for (auto& p : paths) put(p.c_str(), p.size() + 1);
+    while (raw.size() % 4) raw.push_back(0);
+    put(fix.data(), fix.size() * sizeof(Fixup));
+    put(a, la);
+    while (raw.size() % 4) raw.push_back(0);
+    put(b, lb);
+    while (raw.size() % 4) raw.push_back(0);
+    for (uint32_t i = 0; i < kOvlCount; i++) {
+        uint32_t n = (info->*kOvl[i].member) != nullptr ? (uint32_t)ovlSize[i] : 0;
+        put(&n, 4);
+        if (n) put((info->*kOvl[i].member).get(), n);
+        while (raw.size() % 4) raw.push_back(0);
+    }
+
+    std::vector<uint8_t> enc;
+    Encode(raw, enc);
+    std::error_code ec;
+    std::filesystem::create_directories(Dir(), ec);
+    const std::string file = FileFor(slot), tmp = file + ".tmp";
+    FILE* f = fopen(tmp.c_str(), "wb");
+    if (f == nullptr) return false;
+    uint32_t rawSize = (uint32_t)raw.size();
+    bool ok = fwrite("FRSZ", 1, 4, f) == 4 && fwrite(&rawSize, 4, 1, f) == 1 &&
+              fwrite(enc.data(), 1, enc.size(), f) == enc.size();
+    ok = (fflush(f) == 0) && ok;
+    fsync(fileno(f));
+    fclose(f);
+    if (!ok || rename(tmp.c_str(), file.c_str()) != 0) {
+        remove(tmp.c_str());
+        return false;
+    }
+    SPDLOG_INFO("[FakeR36S] state {} written to the card: {} pointers into {} assets, {} KB", slot, fix.size(),
+                paths.size(), (enc.size() + 8) / 1024);
+    return true;
+}
