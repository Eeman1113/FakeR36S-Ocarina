+void SaveStateMgr::FakeR36SFrame(void) {
+    static uint32_t held = 0;          // buttons down last frame, for edge detection
+    static uint32_t lastAutosave = 0;  // SDL ticks
+    static bool exitHeld = false, fpsHeld = false;
+
+    // Everywhere (title screen included), like RetroArch's hotkeys on FakeR36S-OS:
+    //   Select + Start  quit the game cleanly (back to EmulationStation)
+    //   Select + B      show / hide the stats window with the frame rate
+    if (SDL_GameController* p = FR_Pad()) {
+        const bool sel = SDL_GameControllerGetButton(p, SDL_CONTROLLER_BUTTON_BACK);
+        const bool quit = sel && SDL_GameControllerGetButton(p, SDL_CONTROLLER_BUTTON_START);
+        const bool fps = sel && SDL_GameControllerGetButton(p, SDL_CONTROLLER_BUTTON_B);
+        if (quit && !exitHeld) {
+            // keep the moment you quit: a fresh autosave, written to the card before the game closes
+            if (gPlayState != nullptr && CVarGetInteger(CVAR_CHEAT("SaveStatesEnabled"), 0) != 0) {
+                auto s = std::make_shared<SaveState>(OTRGlobals::Instance->gSaveStateMgr, FR_AUTOSAVE_SLOT);
+                s->Save();
+                states[FR_AUTOSAVE_SLOT] = s;
+                frdisk::Enqueue(FR_AUTOSAVE_SLOT, s);
+            }
+            frdisk::WaitIdle(8000);
+            SDL_Event e = {};
+            e.type = SDL_QUIT;
+            SDL_PushEvent(&e);
+        }
+        if (fps && !fpsHeld) {
+            auto stats = Ship::Context::GetRawInstance()->GetWindow()->GetGui()->GetGuiWindow("Stats");
+            if (stats != nullptr) {
+                if (stats->IsVisible()) stats->Hide(); else stats->Show();
+            }
+        }
+        exitHeld = quit;
+        fpsHeld = fps;
+    }
+
+    if (CVarGetInteger(CVAR_CHEAT("SaveStatesEnabled"), 0) == 0 || gPlayState == nullptr) {
+        held = 0;
+        return;
+    }
+
+    SDL_GameController* pad = FR_Pad();
+    uint32_t now = 0;
+    if (pad != nullptr && SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_BACK)) {
+        const SDL_GameControllerButton watched[] = { SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, SDL_CONTROLLER_BUTTON_LEFTSHOULDER,
+                                                     SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDL_CONTROLLER_BUTTON_DPAD_LEFT,
+                                                     SDL_CONTROLLER_BUTTON_X };
+        for (int b = 0; b < 5; b++) {
+            if (SDL_GameControllerGetButton(pad, watched[b])) now |= 1u << b;
+        }
+    }
+    const uint32_t pressed = now & ~held;
+    held = now;
+
+    if (pressed & 1) {
+        AddRequest({ currentSlot, RequestType::SAVE });
+    } else if (pressed & 2) {
+        AddRequest({ currentSlot, RequestType::LOAD });
+    } else if (pressed & 4) {
+        SetCurrentSlot(currentSlot >= 5 ? 0 : currentSlot + 1);
+    } else if (pressed & 8) {
+        SetCurrentSlot(currentSlot == 0 ? 5 : currentSlot - 1);
+    } else if (pressed & 16) {
+        AddRequest({ FR_AUTOSAVE_SLOT, RequestType::LOAD });
+        lastAutosave = SDL_GetTicks();   // don't overwrite the state we just went back to
+    }
+
+    const int every = CVarGetInteger(CVAR_CHEAT("SaveStatesAutosave"), 5);
+    if (every > 0 && SDL_GetTicks() - lastAutosave >= (uint32_t)every * 1000u && requests.empty()) {
+        auto s = std::make_shared<SaveState>(OTRGlobals::Instance->gSaveStateMgr, FR_AUTOSAVE_SLOT);
+        s->Save();   // silent: no notification every 5 seconds
+        states[FR_AUTOSAVE_SLOT] = s;
+        lastAutosave = SDL_GetTicks();
+        static uint32_t lastDisk = 0;
+        const int disk = CVarGetInteger(CVAR_CHEAT("SaveStatesDiskAutosave"), 30);   // seconds, 0 = never
+        if (disk > 0 && SDL_GetTicks() - lastDisk >= (uint32_t)disk * 1000u) {
+            frdisk::Enqueue(FR_AUTOSAVE_SLOT, s);
+            lastDisk = SDL_GetTicks();
+        }
+    }
+}
